# ==============================================================================
# AI Project Reviewer - backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="AI Project Reviewer"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true

# --- API ---------------------------------------------------------------------
API_V1_PREFIX="/api/v1"

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- GitHub -------------------------------------------------------------------
# OPTIONAL. Public repositories work without a token; a token only raises the
# rate limit from 60 to 5000 requests/hour. Use a fine-grained token with NO
# scopes (public read is enough). This value stays server-side and is never
# sent to the browser.
GITHUB_TOKEN=""
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_TIMEOUT_SECONDS=20

# --- Repository retrieval limits ----------------------------------------------
# Guard-rails so a huge repository is never downloaded blindly.
MAX_FILES=40                       # hard cap on files downloaded per analysis
MAX_FILES_UNAUTHENTICATED=15       # lower cap when no GITHUB_TOKEN is set
MAX_FILE_SIZE_BYTES=100000         # skip any single file larger than this
MAX_TOTAL_CONTENT_BYTES=600000     # cumulative content budget per analysis
MAX_TREE_ENTRIES_RETURNED=400      # file paths returned (paths only, no content)
MAX_CONCURRENT_FILE_REQUESTS=5     # parallel GitHub requests; keep this polite

# --- Local LLM: Ollama --------------------------------------------------------
# Requires a local Ollama server. No paid API and no cloud provider is involved.
#   1. Start the server:  ollama serve
#   2. See your models:   ollama list
#   3. Pull one if empty: ollama pull gemma3:4b
# OLLAMA_MODEL must name a model you actually have - run `ollama list` to check.
OLLAMA_BASE_URL="http://localhost:11434"
#
# Model size is the single biggest lever on speed, and it was measured rather
# than guessed. On 2 CPU cores against psf/requests:
#
#   gemma3:4b   304s   prompt 18 tok/s, output 4 tok/s    <- default
#   gemma3:1b    99s   prompt 36 tok/s, output 12 tok/s
#
# 1b is three times faster and is NOT recommended here. It stopped reading the
# extract and started reciting: it returned "psf/requests" as the project
# summary, and strengths of "Simple and easy to use / Well-documented / Widely
# used" - true things about that library, recalled from training rather than
# observed in the evidence. Prose fields carry no citations, so nothing in the
# validation layer can catch it. That is precisely the failure this project
# exists to prevent, so the speed is not worth having.
#
# If you want it anyway, this is the one line to change - nothing is hardcoded.
OLLAMA_MODEL="gemma3:4b"
OLLAMA_TIMEOUT_SECONDS=600     # local CPU inference is slow; be generous
OLLAMA_NUM_CTX=8192            # Ollama defaults to 4096 regardless of the model
OLLAMA_TEMPERATURE=0.0         # 0 = deterministic; analysis should not be creative
OLLAMA_MAX_ATTEMPTS=2          # retries when the model returns unusable JSON
OLLAMA_SEED=-1                 # -1 = unset; set a number to make runs reproducible

# --- Analysis pipeline --------------------------------------------------------
# "fast" (default) or "deep".
#
#   fast  One model call. Measured on gemma3:4b over 2 CPU cores against
#         psf/requests: the deep pipeline spent 673 of 677 seconds inside the
#         model, and 375s of that was prompt processing - because stages 1 and 2
#         each re-sent nearly the same 2,800-token context. Fast sends it once.
#   deep  Three narrower passes: understand, findings, synthesise. Slower, and
#         better at separating what a project *is* from what is *wrong with it*.
#
# Evidence validation, citation checking and scoring are identical in both.
ANALYSIS_MODE="fast"

# Superseded by ANALYSIS_MODE. Honoured only if you set it explicitly, so an
# existing ENABLE_MULTI_STAGE=true keeps selecting the deep pipeline.
# ENABLE_MULTI_STAGE=true

# --- LLM context budget -------------------------------------------------------
# How much repository text may be placed in one prompt (~4 characters per token).
MAX_LLM_CONTEXT_CHARS=8000     # ~5 min per stage on a 4B CPU model at 12000
MAX_LLM_CHARS_PER_FILE=2500
